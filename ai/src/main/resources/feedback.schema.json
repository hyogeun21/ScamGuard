{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "summary": {
      "type": "string",
      "pattern": "\\S"
    },
    "strengths": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "\\S"
      },
      "minItems": 1
    },
    "improvements": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "\\S"
      },
      "minItems": 1
    },
    "recommendation": {
      "type": "string",
      "pattern": "\\S"
    }
  },
  "required": [
    "summary",
    "strengths",
    "improvements",
    "recommendation"
  ],
  "additionalProperties": false
}
